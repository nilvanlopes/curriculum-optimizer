# Provider de IA a ser usado
# Opções: claude, openai, gemini
AI_PROVIDER=claude

# Chave de API para Claude (Anthropic)
# Obtida em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui

# Chave de API para ChatGPT (OpenAI)
# Obtida em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-sua-chave-aqui

# Chave de API para Gemini (Google)
# Obtida em: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=sua-chave-aqui
