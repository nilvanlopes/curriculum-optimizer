# Ordem padrão de fallback quando --provider não for informado.
# --provider usa somente o provider escolhido e não faz fallback.
PROVIDERS_ORDER=gemini,openrouter,ollama

# Fonte opcional; sem ela o CLI descobre exatamente um input/original-curriculum.*.
# CURRICULUM_FILE=/app/input/original-curriculum.pdf

# OpenRouter: este é o único modelo aceito.
OPENROUTER_API_KEY=sk-or-v1-sua-chave-aqui
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://local.curriculum-optimizer
OPENROUTER_APP_NAME=curriculum-optimizer

# OpenAI
# OPENAI_API_KEY=sk-sua-chave
# OPENAI_MODEL=gpt-4.1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (claude é aceito como alias legado em --provider/PROVIDERS_ORDER)
# ANTHROPIC_API_KEY=sk-ant-sua-chave
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Gemini
# GOOGLE_API_KEY=sua-chave
# GOOGLE_MODEL=gemini-3.5-flash

# LM Studio local (chave opcional)
# LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
# LMSTUDIO_MODEL=qwen3-30b-a3b-instruct-2507
# LMSTUDIO_API_KEY=lm-studio

# Ollama OpenAI-compatible (chave opcional)
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_API_KEY=ollama

# UID/GID do usuário local que receberá input/, output/ e data/.
LOCAL_UID=1000
LOCAL_GID=1000
