{
  "name": "cv-optimizer",
  "version": "1.0.0",
  "description": "Sistema automatizado de otimização de currículos para vagas específicas",
  "main": "dist/cli.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx --env-file=.env src/cli.ts",
    "start": "node dist/cli.js",
    "clean": "rm -rf dist",
    "rebuild": "npm run clean && npm run build",
    "test:template": "tsx src/templates/template-tester.ts",
    "serve": "tsx src/cli.ts serve"
  },
  "keywords": [
    "curriculum",
    "cv",
    "resume",
    "ats",
    "optimization"
  ],
  "author": "Douglas Fantoni",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@google/generative-ai": "^0.21.0",
    "better-sqlite3": "^9.2.2",
    "commander": "^11.1.0",
    "openai": "^4.52.0",
    "puppeteer": "^21.6.1",
    "pdf-parse": "^1.1.1",
    "cheerio": "^1.0.0-rc.12",
    "chalk": "^5.3.0",
    "ora": "^7.0.1",
    "marked": "^11.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.10.5",
    "@types/pdf-parse": "^1.1.4",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "vite": "^5.0.0"
  }
}